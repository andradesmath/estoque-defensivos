# Copie para .env (NUNCA faça commit do .env). Mesmos nomes dos Secrets do GitHub.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/estoque_defensivos
SGI_URL_LOGIN=http://IP_DO_SGI:PORTA/login
SGI_LOGIN=
SGI_SENHA=
